  "rules": [
    { "tag": "free", "text": "Subject–Verb–Object order works, just like English." },
    {
      "tag": "delta",
      "text": "\"To be\" vanishes in the present: ismī Rohān (\"my-name Rohan\") — no is/am."
    },
    {
      "tag": "delta",
      "text": "The subject usually lives inside the verb: uḥibb = I-like, urīd = I-want."
    },
    {
      "tag": "interference",
      "text": "General statements keep the article: English \"I like coffee\" → Arabic \"I like THE coffee\" (al-qahwa)."
    }
  ],
